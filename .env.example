# Copy file này thành .env rồi điền giá trị thật. Không commit .env.

# Để trống hoặc MOCK_LLM=true thì app dùng dữ liệu mẫu, không tốn tiền gọi model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MOCK_LLM=true

# Supabase PostgreSQL: Project Settings > Database > Connection parameters.
# Nên dùng "Session pooler" (cổng 5432, chạy được trên mạng IPv4).
# Để trống DB_HOST thì app dùng SQLite local (data/app.db).
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.<project-ref>
DB_PASSWORD=
DB_DATABASE=postgres
DB_SSLMODE=require
