# Copy file này thành .env rồi điền giá trị thật. Không commit .env.

# Để trống hoặc MOCK_LLM=true thì app dùng dữ liệu mẫu, không tốn tiền gọi model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MOCK_LLM=true

# Frontend được phép gọi API (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Múi giờ của app (mặc định GMT+7). Giờ không ghi múi giờ được hiểu theo múi giờ này.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Bài 02: giờ mở/đóng cửa kho (theo APP_TIMEZONE)
DOCK_OPEN=08:00
DOCK_CLOSE=18:00
# Số phút dọn cửa sau mỗi xe. 0 = không dọn (đúng ví dụ trong đề), 15 = phần làm thêm.
DOCK_CLEANUP_MINUTES=0

# Supabase PostgreSQL: Project Settings > Database > Connection parameters.
# Để trống DB_HOST thì app dùng SQLite local (data/app.db).
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.<project-ref>
DB_PASSWORD=
DB_DATABASE=postgres
DB_SSLMODE=require
